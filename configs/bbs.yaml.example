# Template for configs/bbs.yaml, which is gitignored (not tracked)
# because the web admin Settings page can write a real BinkP uplink
# password into it. Copy this file to configs/bbs.yaml and adjust it
# for your system; the BBS daemon falls back to these same built-in
# defaults if configs/bbs.yaml is missing entirely.
bbs:
    name: NullModem BBS
    sysop: sysop
    new_user_sl: 10
    # The board's language (en, de = Deutsch (Sie), de-du = Deutsch (Du)):
    # what callers read before login, and after if they never chose one.
    # language: de
    menus_dir: configs/menus
    screens_dir: configs/screens
    files_dir: data/files
    ftn_addresses: []
    # This system's own FTN address(es)/AKAs (also settable via the
    # web Settings page). Most systems have exactly one; more than one
    # is only needed if a single uplink presents you with more than
    # one FTN network in the same BinkP session:
    # ftn_addresses:
    #     - "1:234/56.0"
    #     - "954:700/14"
database:
    path: data/nullmodem.sqlite
telnet:
    enabled: true
    addr: :2323
ssh:
    enabled: true
    addr: :2222
    host_key_path: data/ssh_host_key
doors: []
    # External door games (see docs/adding-a-door.md) -- none are
    # configured by default; install one under data/doors/<name>/ and
    # add an entry here. "native" (the default kind, e.g. Usurper's
    # own Linux port) or "dosbox" (a classic DOS door run under
    # DOSBox-X, e.g. the Doorway DOS shell):
    # doors:
    #     - name: Usurper
    #       exe: data/doors/usurper/USURPER.EXE
    #       dir: data/doors/usurper
    #       min_sl: 0
    #     - name: DOS Shell (Doorway)
    #       kind: dosbox
    #       dosbox_dir: data/doors/doorway-dos
    #       dosbox_launch_cmd: DOORWAY\DOORWAYU SYS /g:on /a:on /m:100 /v:d^U /s:{dropfile_dir} /c:dos
    #       min_sl: 200   # drops the caller into a real DOS shell -- keep this sysop-only
binkp:
    uplinks: []
    # Each uplink (also settable via the web Settings page, including
    # live "Test Connection"/"Send Now" buttons) looks like:
    # uplinks:
    #     - address: "1:234/56"
    #       host: "bbs.example.com:24554"
    #       password: "..."
    #       poll_disabled: false
    #       hold: false
    #       aka_addresses: []
    # poll_disabled excludes an uplink from the mailer daemon's regular,
    # interval-based scheduled poll -- it's still dialed immediately
    # whenever there's netmail or echomail actually pending for it
    # (ordinary or Crash-flagged alike), plus its own
    # poll_interval_seconds below as a slow fallback if set, or
    # manually via "Send Now".
    # hold marks classic FTN "Hold" status: never dialed automatically
    # for any reason at all, not even poll_disabled's own immediate
    # dial for pending mail -- only via "Send Now", or by the uplink
    # itself polling us. Needed for a peer with no way to reach us back
    # either (e.g. a point behind NAT/no port forwarding), where
    # poll_disabled alone would still trigger a doomed dial attempt
    # whenever mail happens to be pending for it.
    # aka_addresses restricts this uplink to a subset of this
    # system's own ftn_addresses above: only these are presented via
    # M_ADR when this uplink is polled, and only their zones count as
    # this uplink's own for Crash-mail routing -- keeps an AKA that
    # belongs to a different network from leaking into a hub that has
    # nothing to do with it (some hub software auto-registers a new
    # node entry for every address it sees in M_ADR). Empty means
    # unrestricted: every configured address applies to every uplink.
    poll_interval_seconds: 900

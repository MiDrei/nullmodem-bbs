# Build artifacts
/bin/
*.exe

# Runtime state (SSH host keys, databases, generated at first run)
/data/
*_host_key
*.db

# Real BBS config -- the web admin Settings page can write a live
# BinkP uplink password into this file. See configs/bbs.yaml.example
# for the template new checkouts should copy.
/configs/bbs.yaml

# Host-specific docker compose overrides (PUID/PGID)
/.env

# Editor/OS
.DS_Store

# Binaries from a go build in the repo root
/bbs
/mailer
